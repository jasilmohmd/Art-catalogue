# Telegram bot token created with @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=
# Random 1-256 character value containing only A-Z, a-z, 0-9, _ or -.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user IDs allowed to administer the catalogue.
TELEGRAM_ADMIN_IDS=
# Fine-grained GitHub token with Contents: Read and write access to this repository.
GITHUB_TOKEN=
GITHUB_REPOSITORY=jasilmohmd/Art-catalogue
GITHUB_BRANCH=main
